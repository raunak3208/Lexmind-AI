PORT=3000
NODE_ENV=development

# MongoDB connection string (do NOT commit real credentials)
MONGO_URI=mongodb://localhost:27017/lexmind

# Use a long, random secret (e.g. `openssl rand -hex 32`). Required.
JWT_SECRET=
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000

# Comma-separated list of allowed browser origins for CORS.
# Leave unset in development to allow localhost dev origins.
ALLOWED_ORIGINS=

UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=20
